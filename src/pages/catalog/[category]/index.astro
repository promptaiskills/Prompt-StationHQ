---
/**
 * /catalog/[category]/ — one category page: its subcategory collections,
 * live product counts, and a request pathway for unstocked collections.
 * Entirely generated from src/data/taxonomy.json + products.csv.
 */
import BaseLayout from '../../../components/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { SITE } from '../../../config/site.mjs';
import {
  collections,
  getCategoryStats,
  getSubcategoryStats,
  getProductsByCategory,
} from '../../../lib/catalog.ts';
import type { TaxonomyCategory, TaxonomySub } from '../../../lib/catalog.ts';

export function getStaticPaths() {
  return collections.flatMap((coll) =>
    coll.categories.map((cat: TaxonomyCategory) => ({
      params: { category: cat.key },
      props: { category: cat, collection: coll },
    }))
  );
}

interface Props {
  category: TaxonomyCategory;
  collection: { label: string };
}
const { category, collection } = Astro.props;
const stats = getCategoryStats(category.key);
const categoryProducts = getProductsByCategory(category.key).slice(0, 4);
const subCards: Array<TaxonomySub & { count: number }> = category.subcategories.map((s) => ({
  ...s,
  count: getSubcategoryStats(s.key),
}));
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Catalog', href: '/catalog/' },
  { label: category.title },
];
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Catalog', item: `${SITE.url}/catalog/` },
    { '@type': 'ListItem', position: 3, name: category.title, item: `${SITE.url}/catalog/${category.key}/` },
  ],
};
const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${category.title} — AI skill collections`,
  itemListElement: category.subcategories.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.title,
    url: `${SITE.url}/catalog/${category.key}/${s.key}/`,
  })),
};
const metaDesc = `Browse ${category.subcategories.length} AI skill collections in ${category.title} — ready-to-use prompt packs and workflow kits. ${stats.productCount} products live.`;
---
<BaseLayout title={category.title} description={metaDesc} canonical={`/catalog/${category.key}/`}>
  <JsonLd data={[breadcrumbLd, itemListLd]} />
  <section class="border-b border-line bg-surface">
    <div class="container-x py-12">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-6 max-w-3xl">
        <p class="eyebrow">{collection.label}</p>
        <h1 class="mt-3 font-display text-3xl font-bold leading-tight tracking-tight sm:text-4xl">{category.title}</h1>
        <p class="mt-4 text-base leading-relaxed text-ink-soft sm:text-lg">{category.description}</p>
        <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-2 text-sm">
          <div><dt class="sr-only">Collections</dt><dd class="tabular font-semibold">{category.subcategories.length} collections</dd></div>
          <div><dt class="sr-only">Products</dt><dd class="tabular font-semibold">{stats.productCount} products live</dd></div>
          <div><dt class="sr-only">Active</dt><dd class="tabular font-semibold">{stats.subcategoriesWithProducts} stocked</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="container-x py-12 sm:py-16">
    <h2 class="font-display text-2xl font-bold tracking-tight">Collections in this category</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {subCards.map((s) => (
        <article class="card card-hover flex flex-col gap-2 p-5">
          <div class="flex items-start justify-between gap-3">
            <h3 class="font-display text-lg font-bold leading-snug tracking-tight">
              <a href={`/catalog/${category.key}/${s.key}/`} class="rounded-sm transition-colors hover:text-brand">{s.title}</a>
            </h3>
            {s.count > 0 ? (
              <span class="badge shrink-0 tabular">{s.count} {s.count === 1 ? 'product' : 'products'}</span>
            ) : (
              <span class="rounded-md border border-dashed border-line-strong px-2 py-0.5 text-[11px] font-medium text-ink-faint">stocking</span>
            )}
          </div>
          <p class="line-clamp-2 text-sm leading-relaxed text-ink-soft">{s.summary}</p>
          <div class="mt-auto flex items-center gap-3 pt-2">
            {s.count > 0 ? (
              <a href={`/catalog/${category.key}/${s.key}/`} class="btn-link px-0 py-0 text-sm">View collection →</a>
            ) : (
              <a href={`/request/?q=${encodeURIComponent(s.title)}&source=category`} class="btn-link px-0 py-0 text-sm">Request it →</a>
            )}
          </div>
        </article>
      ))}
    </div>

    {categoryProducts.length > 0 && (
      <div class="mt-14">
        <h2 class="font-display text-2xl font-bold tracking-tight">Recent products in this category</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {categoryProducts.map((p) => (
            <article class="card card-hover flex flex-col overflow-hidden">
              <a href={`/products/${p.slug}/`} class="block aspect-[4/3] overflow-hidden bg-brand-soft" tabindex="-1" aria-hidden="true">
                <img src={`/${p.image ?? 'images/placeholder.svg'}`} alt="" width="1200" height="900" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-200 hover:scale-[1.02]" />
              </a>
              <div class="flex flex-1 flex-col gap-1.5 p-4">
                <h3 class="font-display text-[0.95rem] font-bold leading-snug tracking-tight">
                  <a href={`/products/${p.slug}/`} class="rounded-sm transition-colors hover:text-brand">{p.name}</a>
                </h3>
              </div>
            </article>
          ))}
        </div>
      </div>
    )}

    <div class="mt-16 flex flex-col items-center gap-4 rounded-md border border-line bg-surface px-6 py-10 text-center sm:flex-row sm:justify-between sm:text-left">
      <div>
        <h2 class="font-display text-xl font-bold tracking-tight">Need a skill this catalog doesn’t have?</h2>
        <p class="mt-1 text-sm text-ink-soft">We take custom requests — describe the skill’s nature, behavior and topics.</p>
      </div>
      <a href={`/request/?q=${encodeURIComponent(category.title)}&source=category`} class="btn-primary shrink-0">Request in {category.title}</a>
    </div>
  </section>
</BaseLayout>