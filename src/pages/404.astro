---
/**
 * 404 — helpful not-found page: search, popular categories, request CTA.
 * Netlify serves this for every unmatched route (public/404.html after build).
 */
import BaseLayout from '../components/BaseLayout.astro';
import { getProducts } from '../lib/catalog.ts';

const popular = getProducts().filter((p) => p.featured).slice(0, 3);
---
<BaseLayout title="Page not found" description="The page you are looking for does not exist." canonical="/404/">
  <section class="container-x py-16 sm:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">404</p>
      <h1 class="mt-3 font-display text-4xl font-bold tracking-tight sm:text-5xl">This page is off the shelf</h1>
      <p class="mt-4 text-base leading-relaxed text-ink-soft">
        The page you followed doesn’t exist — but the catalog does. Search below, browse a category, or tell us what
        you were looking for.
      </p>

      <form action="/search/" method="get" role="search" class="mx-auto mt-8 flex max-w-xl gap-3">
        <label for="nf-search" class="is-sr-only">Search products</label>
        <input id="nf-search" type="search" name="q" placeholder="Search AI skills…" autocomplete="off" class="field-input flex-1 text-base" />
        <button type="submit" class="btn-primary shrink-0">Search</button>
      </form>

      <div class="mt-6 flex flex-col items-center gap-2">
        <a href="/catalog/" class="btn-outline px-5 py-2.5">Browse the full catalog</a>
        <a href="/request/" class="text-sm font-semibold text-brand underline-offset-2 hover:underline">or request the skill you need →</a>
      </div>
    </div>

    <div class="mt-14 grid gap-4 sm:grid-cols-3">
      {popular.map((p) => (
        <a href={`/products/${p.slug}/`} class="card card-hover flex items-center gap-4 p-4">
          <img src={`/${p.image ?? 'images/placeholder.svg'}`} alt="" width="600" height="450" loading="lazy" decoding="async" class="h-16 w-16 shrink-0 rounded-md object-cover" />
          <span>
            <span class="line-clamp-1 block font-display text-sm font-bold">{p.name}</span>
            <span class="block text-xs text-ink-faint">{p.subcategoryTitle}</span>
          </span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>