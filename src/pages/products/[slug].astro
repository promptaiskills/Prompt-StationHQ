---
/**
 * /products/[slug]/ — product detail page. Generated for every published row
 * in products.csv. Empty fields are never rendered (see <If> guards).
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GumroadButton from '../../components/GumroadButton.astro';
import ProductCard from '../../components/ProductCard.astro';
import FaqList from '../../components/FaqList.astro';
import JsonLd from '../../components/JsonLd.astro';
import { SITE } from '../../config/site.mjs';
import { getProducts, getRelatedProducts } from '../../lib/catalog.ts';
import { formatPrice } from '../../lib/format.mjs';
import type { Product } from '../../lib/catalog.ts';

export function getStaticPaths() {
  return getProducts().map((p) => ({
    params: { slug: p.slug },
    props: { product: p },
  }));
}

interface Props {
  product: Product;
}
const { product } = Astro.props;
const hasImage = product.image ? existsSync(join(process.cwd(), 'public', product.image)) : false;
const heroImage = hasImage ? product.image : null;
const gallery = product.gallery.filter((g) => g && existsSync(join(process.cwd(), 'public', g)));
const galleryImages = gallery.length > 0 ? gallery : (heroImage ? [product.image!] : []);
const path = `/products/${product.slug}/`;
const price = formatPrice(product.price, product.currency);
const compare = product.compareAtPrice ? formatPrice(product.compareAtPrice, product.currency) : null;
const paragraphs = product.description.split(/\n{2,}/).map((p) => p.trim()).filter(Boolean);
const initials = product.name.split(/\s+/).slice(0, 2).map((w) => w.charAt(0).toUpperCase()).join('');
const related = getRelatedProducts(product, 4);
const metacols: Array<[string, string]> = [];
if (product.productType) metacols.push(['Product type', product.productType.replace(/-/g, ' ')]);
if (product.fileFormat) metacols.push(['Format', product.fileFormat]);
if (product.compatibility) metacols.push(['Works with', product.compatibility]);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Catalog', item: `${SITE.url}/catalog/` },
    { '@type': 'ListItem', position: 3, name: product.categoryTitle, item: `${SITE.url}/catalog/${product.categoryKey}/` },
    product.subcategoryKey ? { '@type': 'ListItem', position: 4, name: product.subcategoryTitle, item: `${SITE.url}/catalog/${product.categoryKey}/${product.subcategoryKey}/` } : null,
    { '@type': 'ListItem', position: 5, name: product.name, item: `${SITE.url}${path}` },
  ].filter(Boolean),
};
const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  sku: product.id,
  description: product.shortDescription || product.description.slice(0, 500),
  brand: { '@type': 'Brand', name: SITE.name },
  category: product.categoryTitle,
  image: galleryImages.map((g) => `${SITE.url}/${g}`),
  offers: {
    '@type': 'Offer',
    url: `${SITE.url}${path}`,
    price: product.price,
    priceCurrency: product.currency,
    availability: 'https://schema.org/InStock',
    seller: { '@type': 'Organization', name: SITE.name },
  },
};
const trustPoints = [
  { t: 'Instant delivery', b: 'Secure links & receipt arrive by email right after purchase.' },
  { t: 'Secure checkout', b: 'Payments handled by Gumroad (Stripe) — no card data touches this site.' },
  { t: 'Always accessible', b: 'Your files stay in your Gumroad library — re-download anytime.' },
];
---
<BaseLayout title={product.seoTitle} description={product.seoDescription} canonical={path} ogType="article">
  <JsonLd data={[breadcrumbLd, productLd]} />
  <section class="container-x py-10 sm:py-14">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Catalog', href: '/catalog/' },
        { label: product.categoryTitle, href: `/catalog/${product.categoryKey}/` },
        ...(product.subcategoryKey ? [{ label: product.subcategoryTitle, href: `/catalog/${product.categoryKey}/${product.subcategoryKey}/` }] : []),
        { label: product.name },
      ]}
    />

    <div class="mt-8 grid gap-10 lg:grid-cols-[0.95fr_1.05fr]">
      <!-- Gallery -->
      <div data-gallery>
        <figure class="card overflow-hidden">
          {galleryImages.length > 0 && galleryImages[0] ? (
            <img
              data-gallery-main
              src={`/${galleryImages[0]}`}
              alt={`${product.name} — product cover`}
              width="1200"
              height="900"
              fetchpriority="high"
              decoding="async"
              class="aspect-[4/3] w-full object-cover"
            />
          ) : (
            <div class="flex aspect-[4/3] w-full flex-col items-center justify-center gap-2 bg-brand-soft text-brand">
              <span class="font-display text-7xl font-bold opacity-20">{initials}</span>
              <span class="text-xs font-semibold uppercase tracking-[0.2em] opacity-40">Sample cover</span>
            </div>
          )}
        </figure>
        {galleryImages.length > 1 && (
          <div class="mt-3 grid grid-cols-4 gap-3" role="group" aria-label="Product image gallery">
            {galleryImages.map((g, i) => (
              <button
                type="button"
                data-gallery-thumb
                data-src={`/${g}`}
                data-alt={`${product.name} — image ${i + 1}`}
                class="overflow-hidden rounded-md border border-line transition hover:border-ink focus-visible:border-brand"
                aria-label={`View image ${i + 1}`}
              >
                <img src={`/${g}`} alt="" width="600" height="450" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover" />
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- Buy panel -->
      <div>
        <div class="flex items-center justify-between gap-3">
          <p class="text-sm font-medium text-ink-faint">
            <a href={`/catalog/${product.categoryKey}/`} class="rounded-sm hover:text-brand hover:underline">{product.categoryTitle}</a>
            {product.subcategoryKey && (
              <>
                <span aria-hidden="true"> / </span>
                <a href={`/catalog/${product.categoryKey}/${product.subcategoryKey}/`} class="rounded-sm hover:text-brand hover:underline">{product.subcategoryTitle}</a>
              </>
            )}
          </p>
          {product.featured && <span class="badge">Featured</span>}
        </div>

        <h1 class="mt-3 font-display text-3xl font-bold leading-tight tracking-tight sm:text-4xl">{product.name}</h1>
        {product.shortDescription && <p class="mt-4 text-base leading-relaxed text-ink-soft sm:text-lg">{product.shortDescription}</p>}

        <div class="mt-6 flex items-baseline gap-3">
          <span class="tabular font-display text-3xl font-bold">{price}</span>
          {compare && <span class="tabular text-lg text-ink-faint line-through">{compare}</span>}
          {product.compareAtPrice && (
            <span class="rounded-md bg-success-soft px-2 py-0.5 text-xs font-semibold text-success">
              Save {formatPrice(product.compareAtPrice - product.price, product.currency)}
            </span>
          )}
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <GumroadButton product={product} size="lg" label={`Buy now — ${price}`} />
          <a href="/how-it-works/" class="btn-outline px-5 py-3 text-base">How delivery works</a>
        </div>
        <p class="mt-3 text-xs text-ink-faint">Secure checkout opens in a Gumroad window. Your files land in your Gumroad library.</p>

        <ul class="mt-6 grid gap-3 sm:grid-cols-3">
          {trustPoints.map((tp) => (
            <li class="rounded-md border border-line bg-paper px-3 py-2.5">
              <p class="text-xs font-bold text-ink">{tp.t}</p>
              <p class="mt-0.5 text-[11px] leading-relaxed text-ink-faint">{tp.b}</p>
            </li>
          ))}
        </ul>

        {metacols.length > 0 && (
          <dl class="mt-6 divide-y divide-line rounded-md border border-line bg-surface">
            {metacols.map(([k, v]) => (
              <div class="flex items-start justify-between gap-4 px-4 py-3">
                <dt class="text-sm text-ink-faint">{k}</dt>
                <dd class="text-right text-sm font-semibold text-ink">{v}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>
    </div>
  </section>

  <!-- Description & details -->
  {paragraphs.length > 0 && (
    <section class="border-y border-line bg-surface">
      <div class="container-x grid gap-12 py-12 sm:py-16 lg:grid-cols-[1.2fr_0.8fr]">
        <div class="max-w-2xl space-y-5 text-base leading-relaxed text-ink-soft">
          {paragraphs.map((p) => <p>{p}</p>)}
        </div>

        <div class="space-y-8">
          {product.benefits.length > 0 && (
            <div>
              <h2 class="font-display text-xl font-bold tracking-tight">Benefits</h2>
              <ul class="mt-4 space-y-2.5">
                {product.benefits.map((b) => (
                  <li class="flex items-start gap-3 text-sm text-ink-soft">
                    <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="mt-0.5 shrink-0 text-brand"><circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.4"/><path d="M6 10.2l2.6 2.6L14 7.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {product.includes.length > 0 && (
            <div>
              <h2 class="font-display text-xl font-bold tracking-tight">What’s included</h2>
              <ul class="mt-4 space-y-2.5">
                {product.includes.map((i) => (
                  <li class="flex items-start gap-3 text-sm text-ink-soft">
                    <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="mt-0.5 shrink-0 text-accent"><path d="M6 10h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.4"/></svg>
                    <span>{i}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {product.features.length > 0 && (
            <div>
              <h2 class="font-display text-xl font-bold tracking-tight">Notable features</h2>
              <ul class="mt-4 space-y-2.5">
                {product.features.map((f) => (
                  <li class="flex items-start gap-3 text-sm text-ink-soft">
                    <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="mt-0.5 shrink-0 text-accent"><path d="M10 2.5l2.3 4.6 5.2.8-3.7 3.6.9 5.1L10 14.1l-4.7 2.5.9-5.1L2.5 7.9l5.2-.8z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {product.tags.length > 0 && (
    <section class="container-x py-10">
      <h2 class="sr-only">Tags</h2>
      <ul class="flex flex-wrap gap-2">
        {product.tags.map((t) => (
          <li>
            <a href={`/search/?q=${encodeURIComponent(t)}`} class="badge transition-colors hover:border-brand hover:text-brand">#{t}</a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {product.faqs.length > 0 && (
    <section class="container-x pb-6">
      <FaqList items={product.faqs} />
    </section>
  )}

  {related.length > 0 && (
    <section class="container-x py-12 sm:py-16">
      <h2 class="font-display text-2xl font-bold tracking-tight">You may also need</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {related.map((p) => <ProductCard product={p} />)}
      </div>
    </section>
  )}

  <section class="container-x pb-4">
    <div class="rounded-md border border-brand/20 bg-brand-soft px-6 py-8 sm:px-10">
      <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
        <div>
          <h2 class="font-display text-xl font-bold tracking-tight text-brand">Want this skill customized for your workflow?</h2>
          <p class="mt-1 text-sm text-ink-soft">Tell us the nature, behavior and topics you need — we design skills on request.</p>
        </div>
        <a href={`/request/?q=${encodeURIComponent(product.name)}&source=product`} class="btn-primary shrink-0">Request a custom version</a>
      </div>
    </div>
  </section>

  <script>
    import '../../scripts/gallery.ts';
  </script>
</BaseLayout>