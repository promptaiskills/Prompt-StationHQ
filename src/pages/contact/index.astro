---
/**
 * /contact/ — general inquiries (Netlify Form) + business details.
 */
import BaseLayout from '../../components/BaseLayout.astro';
import { SITE } from '../../config/site.mjs';

const contactVisible = SITE.contact.email && !/YOUR_/.test(SITE.contact.email);
const email = contactVisible ? SITE.contact.email : '';
---
<BaseLayout
  title="Contact us"
  description={`Questions about products, purchases or the catalog? Contact ${SITE.name}.`}
  canonical="/contact/"
>
  <section class="border-b border-line bg-surface">
    <div class="container-x py-12 sm:py-16">
      <p class="eyebrow">Contact</p>
      <h1 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">Talk to a human</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-soft">
        Need help with a purchase, a download, or a product question? Use the form, or email us directly — we reply to
        everything.
      </p>
    </div>
  </section>

  <div class="container-x grid gap-10 py-12 sm:py-16 lg:grid-cols-[0.8fr_1.2fr]">
    <aside class="space-y-5">
      {email && (
        <a href={`mailto:${email}`} class="card card-hover flex items-center gap-4 p-5">
          <span class="flex h-10 w-10 items-center justify-center rounded-md bg-brand-soft text-brand" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          </span>
          <span>
            <span class="block text-sm font-bold text-ink">Email us</span>
            <span class="block text-sm text-ink-soft">{email}</span>
          </span>
        </a>
      )}
      <a href="/how-it-works/#delivery" class="card card-hover flex items-center gap-4 p-5">
        <span class="flex h-10 w-10 items-center justify-center rounded-md bg-brand-soft text-brand" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 7a3 3 0 013-3h12a3 3 0 013 3v8a3 3 0 01-3 3H6a3 3 0 01-3-3z"/><path d="M3 10h18M9 17v3m6-3v3"/></svg>
        </span>
        <span>
          <span class="block text-sm font-bold text-ink">Purchase or download help</span>
          <span class="block text-sm text-ink-soft">See How it works → delivery & access</span>
        </span>
      </a>
      <a href="/request/" class="card card-hover flex items-center gap-4 p-5">
        <span class="flex h-10 w-10 items-center justify-center rounded-md bg-brand-soft text-brand" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 3l2.4 2.1 3.2-.4 1 3.1 2.9 1.5-1 3.1 1 3.1-2.9 1.5-1 3.1-3.2-.4L12 21l-2.4-2.1-3.2.4-1-3.1-2.9-1.5 1-3.1-1-3.1 2.9-1.5 1-3.1 3.2.4z"/></svg>
        </span>
        <span>
          <span class="block text-sm font-bold text-ink">Need a custom skill?</span>
          <span class="block text-sm text-ink-soft">Use the service-request flow instead</span>
        </span>
      </a>
    </aside>

    <div>
      <form data-contact-form name="contact" method="post"  data-netlify="true" data-netlify-honeypot="hp" class="card p-6 sm:p-8">
        <input type="hidden" name="form-name" value="contact" />
        <div class="hidden" aria-hidden="true"><input name="hp" type="text" tabindex="-1" autocomplete="off" /></div>
        <h2 class="font-display text-xl font-bold tracking-tight">Send a message</h2>
        <div class="mt-5 grid gap-5 sm:grid-cols-2">
          <div>
            <label for="c-name" class="field-label">Name <span class="text-danger" aria-hidden="true">*</span></label>
            <input id="c-name" name="name" required autocomplete="name" class="field-input" />
          </div>
          <div>
            <label for="c-email" class="field-label">Email <span class="text-danger" aria-hidden="true">*</span></label>
            <input id="c-email" name="email" type="email" required autocomplete="email" class="field-input" />
          </div>
        </div>
        <div class="mt-5">
          <label for="c-subject" class="field-label">Subject</label>
          <input id="c-subject" name="subject" class="field-input" placeholder="e.g. My download link expired" />
        </div>
        <div class="mt-5">
          <label for="c-message" class="field-label">Message <span class="text-danger" aria-hidden="true">*</span></label>
          <textarea id="c-message" name="message" required rows="6" class="field-input"></textarea>
        </div>
        <div data-contact-error role="alert" class="mt-4 rounded-md border border-danger/30 bg-danger-soft px-4 py-3 text-sm text-danger" hidden></div>
        <div class="mt-6 flex items-center justify-between gap-4">
          <button type="submit" class="btn-primary">Send message</button>
          <p class="text-xs text-ink-faint">We never share your details.</p>
        </div>
      </form>

      <div data-contact-success hidden tabindex="-1" class="card mt-0 p-8 sm:p-10">
        <p class="eyebrow">Message sent</p>
        <h2 class="mt-3 font-display text-xl font-bold tracking-tight">Thanks — we’ll get back to you</h2>
        <p class="mt-2 text-sm text-ink-soft">If it’s urgent, email us directly using the address on this page.</p>
      </div>
    </div>
  </div>

  <script>
    import '../../scripts/contact.ts';
  </script>
</BaseLayout>
