---
/**
 * ProductCard — one product in any grid. Purely data-driven from the CSV.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import type { Product } from '../lib/catalog.ts';
import { formatPrice } from '../lib/format.mjs';
import GumroadButton from './GumroadButton.astro';

interface Props {
  product: Product;
  showCategory?: boolean;
}
const { product, showCategory = true } = Astro.props;
const href = `/products/${product.slug}/`;
const hasImage = product.image ? existsSync(join(process.cwd(), 'public', product.image)) : false;
const price = formatPrice(product.price, product.currency);
const compare = product.compareAtPrice ? formatPrice(product.compareAtPrice, product.currency) : null;
const initials = product.name
  .split(/\s+/)
  .slice(0, 2)
  .map((w) => w.charAt(0).toUpperCase())
  .join('');
---
<article class="card card-hover group flex flex-col overflow-hidden">
  <a href={href} class="relative block aspect-[4/3] overflow-hidden bg-brand-soft" tabindex="-1" aria-hidden="true">
    {hasImage ? (
      <img
        src={`/${product.image}`}
        alt={`${product.name} — product cover`}
        width="1200"
        height="900"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-200 group-hover:scale-[1.02]"
      />
    ) : (
      <span class="flex h-full w-full flex-col items-center justify-center gap-2 text-brand" aria-hidden="true">
        <span class="font-display text-5xl font-bold opacity-25">{initials}</span>
        <span class="text-xs font-semibold uppercase tracking-[0.2em] opacity-40">Sample cover</span>
      </span>
    )}
    <span class="absolute left-3 top-3 flex gap-1.5">
      {product.featured && (
        <span class="inline-flex items-center gap-1 rounded-md bg-ink/85 px-2 py-0.5 text-[11px] font-semibold text-paper backdrop-blur">
          <svg width="11" height="11" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1.5l2.47 5.01 5.53.8-4 3.9.94 5.5L10 14.11 5.06 16.7l.94-5.5-4-3.9 5.53-.8z"/></svg>
          Featured
        </span>
      )}
    </span>
    <span class="absolute bottom-3 left-3 rounded-md bg-surface/90 px-2 py-0.5 text-[11px] font-medium text-ink-soft backdrop-blur">
      {product.productType.replace(/-/g, ' ')}
    </span>
  </a>

  <div class="flex flex-1 flex-col gap-2 p-4 sm:p-5">
    {showCategory && (
      <p class="text-xs font-medium text-ink-faint">
        <a href={`/catalog/${product.categoryKey}/`} class="rounded-sm hover:text-brand hover:underline">{product.categoryTitle}</a>
        <span aria-hidden="true"> · </span>
        <a href={`/catalog/${product.categoryKey}/${product.subcategoryKey}/`} class="rounded-sm hover:text-brand hover:underline">{product.subcategoryTitle}</a>
      </p>
    )}
    <h3 class="font-display text-[1.05rem] font-bold leading-snug tracking-tight">
      <a href={href} class="rounded-sm transition-colors hover:text-brand">{product.name}</a>
    </h3>
    <p class="line-clamp-2 text-sm leading-relaxed text-ink-soft">{product.shortDescription}</p>

    <div class="mt-auto flex items-center justify-between gap-3 pt-3">
      <p class="flex items-baseline gap-2">
        <span class="tabular font-display text-lg font-bold">{price}</span>
        {compare && <span class="tabular text-sm text-ink-faint line-through">{compare}</span>}
      </p>
      <GumroadButton product={product} size="sm" />
    </div>
  </div>
</article>