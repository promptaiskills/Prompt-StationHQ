---
/**
 * SectionHeading — consistent heading block: eyebrow + title + optional lede.
 */
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  align?: 'left' | 'center';
  size?: 'lg' | 'md';
  as?: 'h1' | 'h2';
}
const { eyebrow, title, lede, align = 'left', size = 'lg', as = 'h2' } = Astro.props;
const Tag = as;
const alignCls = align === 'center' ? 'text-center mx-auto' : '';
const titleSize = size === 'lg' ? 'text-3xl sm:text-4xl' : 'text-2xl sm:text-3xl';
---
<div class={`max-w-3xl ${alignCls}`}>
  {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
  <Tag class={`font-display font-bold tracking-tight ${titleSize}`}>{title}</Tag>
  {lede && <p class="mt-3 text-base leading-relaxed text-ink-soft sm:text-lg">{lede}</p>}
</div>