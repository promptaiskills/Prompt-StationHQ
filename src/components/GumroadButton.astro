---
/**
 * GumroadButton — the secure checkout trigger.
 *
 * Renders an <a> with Gumroad's official "Overlay" classes. When the small
 * gumroad.js library has loaded (injected lazily by src/scripts/buy.ts),
 * clicking opens Gumroad's hosted checkout in an overlay so the customer
 * never leaves Prompt Station to pay. With JavaScript disabled, the same
 * link simply takes the customer to the Gumroad checkout page — graceful
 * degradation, no extra code paths.
 *
 * Props are published on `data-ps` for the purchase dialog (buy.ts).
 */
import { formatPrice } from '../lib/format.mjs';

export interface BuyPayload {
  name: string;
  price: number;
  currency: string;
  compareAt: number | null;
  url: string;
  slug: string;
  format: string;
}

interface Props {
  product: {
    name: string;
    price: number;
    currency: string;
    compareAtPrice: number | null;
    gumroadUrl: string;
    slug: string;
    fileFormat: string;
  };
  label?: string;
  variant?: 'primary' | 'dark' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { product, label, variant = 'primary', size = 'md' } = Astro.props;
const price = formatPrice(product.price, product.currency);
const sizes = { sm: 'px-3 py-1.5 text-sm', md: 'px-4 py-2.5 text-sm', lg: 'px-6 py-3.5 text-base' };
const variants = {
  primary: 'bg-brand text-white hover:bg-brand-deep',
  dark: 'bg-ink text-paper hover:bg-ink-soft',
  outline: 'border border-line-strong bg-surface text-ink hover:border-ink',
};
const payload: BuyPayload = {
  name: product.name,
  price: product.price,
  currency: product.currency,
  compareAt: product.compareAtPrice,
  url: product.gumroadUrl,
  slug: product.slug,
  format: product.fileFormat,
};
const rel = product.gumroadUrl.startsWith('/') ? undefined : 'noopener';
---
{
  product.gumroadUrl ? (
    <a
      href={product.gumroadUrl}
      rel={rel}
      class:list={[
        'gumroad-button inline-flex items-center justify-center gap-2 rounded-md font-semibold transition-colors',
        sizes[size],
        variants[variant],
        Astro.props.class,
      ]}
      data-gumroad-single-product="true"
      data-ps={JSON.stringify(payload)}
    >
      {label ?? `Buy now — ${price}`}
    </a>
  ) : (
    <span class:list={['inline-flex items-center gap-2 rounded-md bg-ink/5 px-4 py-2.5 text-sm font-semibold text-ink-faint', sizes[size]]}>
      Coming soon
    </span>
  )
}