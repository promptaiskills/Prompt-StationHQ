---
/**
 * FaqList — accessible FAQ using native <details>/<summary>.
 * Pairs: {q, a} — blank answers render a "coming soon" note.
 */
export interface FaqPair {
  q: string;
  a: string;
}
interface Props {
  items: FaqPair[];
  title?: string;
}
const { items, title = 'Frequently asked questions' } = Astro.props;
const valid = items.filter((f) => f.q.trim());
---
{valid.length > 0 && (
  <section aria-label={title}>
    <h2 class="mb-4 text-xl font-bold tracking-tight">{title}</h2>
    <div class="divide-y divide-line rounded-md border border-line bg-surface">
      {valid.map((f) => (
        <details class="group px-5">
          <summary class="flex items-center justify-between gap-4 py-4 font-semibold text-ink">
            {f.q}
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="shrink-0 transition-transform duration-150 group-open:rotate-45">
              <path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
          </summary>
          <div class="pb-4 text-sm leading-relaxed text-ink-soft">
            {f.a ? <p>{f.a}</p> : <p class="italic">Full answer coming soon — <a href="/contact" class="underline hover:text-brand">ask us</a> in the meantime.</p>}
          </div>
        </details>
      ))}
    </div>
  </section>
)}