# ---------------------------------------------------------------
# Environment variables — copy to .env (local) or set in Netlify
# Site settings → Environment variables before going live.
#
# Nothing here is REQUIRED for the core storefront to work:
# the storefront, checkout overlay, and Netlify Forms all run without
# any secrets. These variables only power the optional serverless
# integration points described in docs/GUMROAD_SETUP.md.
# ---------------------------------------------------------------

# Optional — shared secret that must appear as ?token=... on Gumroad "Ping"
# webhook calls forwarded to the /api/gumroad-ping function. Set the Ping
# URL in Gumroad as:  https://YOUR-SITE.netlify.app/api/gumroad-ping?token=YOUR_GUMROAD_PING_SECRET
# (In settings → Advanced → Ping, append the secret yourself.)
GUMROAD_PING_SECRET=change-me-before-production

# Site URL — must match the production domain for canonical tags & sitemap.
# Set in src/config/site.mjs (SITE.url); optionally mirrored here.
SITE_URL=https://YOUR-STORE.netlify.app